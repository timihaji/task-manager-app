# Supabase
# Find these in your Supabase project dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Stripe (Phase 3, not needed yet)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Apple Reminders pull-and-archive helper (macOS only — scripts/apple-reminders-sync)
# Your Task Manager login; the helper signs in as you so writes respect RLS.
# TM_EMAIL=you@example.com
# TM_PASSWORD=your-task-manager-password
# TM_PROJECT=LIFE                 # default context for imported reminders
# REMINDERS_LISTS=Inbox,Work      # default lists to pull (omit = all lists)
